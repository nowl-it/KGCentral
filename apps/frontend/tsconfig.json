{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"composite": true,
		"lib": ["dom", "dom.iterable", "ES2022"],
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@kgcentral/ui/*": ["../../packages/ui/src/*"],
			"@kgcentral/i18n/*": ["../../packages/i18n/src/*"]
		},
		"isolatedModules": true
	},
	"references": [
		{
			"path": "../../packages/ui"
		}
	],
	"include": ["next.config.ts", "src/**/*", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
