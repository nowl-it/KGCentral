{
	"name": "kgcentral",
	"version": "1.0.0",
	"private": true,
	"description": "KGCentral Monorepo - Frontend, Backend, AI for Raspberry Pi",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"test": "turbo test",
		"clean": "turbo clean",
		"docker:build": "turbo docker:build",
		"docker:up": "docker-compose -f docker-compose.yml up -d",
		"docker:down": "docker-compose -f docker-compose.yml down",
		"k3s:deploy": "kubectl apply -k devops/k8s/overlays/dev",
		"k3s:undeploy": "kubectl delete -k devops/k8s/overlays/dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"turbo": "^2.4.4",
		"typescript": "^5.7.3"
	},
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	}
}
